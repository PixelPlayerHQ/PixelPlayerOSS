    <string-array name="presentation_batch_g_changelog_060_whats_new">
        <item>Nedávno prehrané skladby a obnovenie uloženého frontu vám umožnia pokračovať v počúvaní tam, kde ste prestali.</item>
        <item>Pribudlo zálohovanie a obnovenie vo verzii 3 a nástroje na správu účtov.</item>
        <item>Pribudlo ručné vyhľadávanie textov, keď automatické zlyhá, a zlepšilo sa ich ukladanie.</item>
    </string-array>
    <string-array name="presentation_batch_g_changelog_060_improvements">
        <item>Zrýchlilo sa spúšťanie aplikácie aj práca s knižnicou, frontom a prehrávačom.</item>
        <item>Navigácia a vyhľadávanie sú spoľahlivejšie vďaka bezpečnejšiemu otváraniu obrazoviek.</item>
        <item>Prehrávanie zvuku funguje na väčšom počte zariadení a s viacerými formátmi.</item>
        <item>Rozšírili sa možnosti výberu viacerých skladieb, albumov a zoznamov skladieb.</item>
    </string-array>
    <string-array name="presentation_batch_g_changelog_060_fixes">
        <item>Front a náhodné prehrávanie fungujú stabilnejšie a predvídateľnejšie.</item>
        <item>Opravili sa problémy s časovačom vypnutia, navigáciou na karte Súbory a pádmi pri zobrazení interpreta albumu.</item>
        <item>Načítanie miniaplikácií a stabilita služieb sa zlepšili, aby sa obmedzili problémy s prehrievaním a pamäťou.</item>
        <item>Opravili sa ďalšie chyby a vyladilo sa rozhranie v celej aplikácii.</item>
    </string-array>
    <string-array name="presentation_batch_g_changelog_050_highlights">
        <item>Nové rozhranie v štýle Material 3 Expressive</item>
        <item>10-pásmový ekvalizér a efekty</item>
        <item>Nový spôsob synchronizácie knižnice</item>
        <item>Import a export zoznamov skladieb M3U</item>
        <item>Fotografie interpretov zo služby Deezer</item>
        <item>Vlastné obaly zoznamov skladieb</item>
    </string-array>
    <string-array name="presentation_batch_g_changelog_050_improvements">
        <item>Prepracovaná štruktúra nastavení</item>
        <item>Animácie frontu a prehrávača</item>
        <item>Profily Baseline a lepší výkon</item>
        <item>Vylepšené texty skladieb s nastaviteľným časovým posunom</item>
    </string-array>
    <string-array name="presentation_batch_g_changelog_050_fixes">
        <item>Stabilnejší panel prehrávača</item>
        <item>Opravy chýb a vyčistenie kódu</item>
    </string-array>
    <string-array name="presentation_batch_g_changelog_040_highlights">
        <item>Výrazne prepracovaná navigácia</item>
        <item>Nový prehliadač súborov na výber zdrojových priečinkov</item>
        <item>Plynulé pokračovanie medzi vzdialenými zariadeniami</item>
        <item>Prechody medzi skladbami bez medzier</item>
        <item>Ovládanie prelínania</item>
        <item>Vlastné prechody pri zoznamoch skladieb</item>
        <item>Pokračovanie v prehrávaní po zatvorení aplikácie</item>
        <item>Optimalizácia rozhrania</item>
        <item>Vylepšené štatistiky</item>
        <item>Prepracované ovládanie frontu s ďalšími funkciami</item>
        <item>Lepšia podpora rôznych typov súborov pri prehrávaní a úprave metadát</item>
        <item>Lepšia správa povolení</item>
        <item>Opravy menších chýb</item>
    </string-array>
    <string-array name="presentation_batch_g_changelog_030_whats_new">
        <item>Podrobnejšie štatistiky počúvania s lepším prehľadom jednotlivých relácií.</item>
        <item>Plávajúci rýchly prehrávač na okamžité otvorenie a vypočutie miestnych súborov.</item>
        <item>Karta Priečinky so stromovým prehľadom a zobrazením vhodným na tvorbu zoznamov skladieb.</item>
    </string-array>
    <string-array name="presentation_batch_g_changelog_030_improvements">
        <item>Rozhranie Material 3 je prehľadnejšie a jednotnejšie.</item>
        <item>Pri úprave metadát možno zmeniť aj obal.</item>
        <item>Plynulejšie animácie a prechody uľahčujú navigáciu v celej aplikácii.</item>
        <item>Prepracovaná stránka interpreta zobrazuje podrobnejšie údaje.</item>
        <item>Denný mix a Váš mix vyberajú skladby presnejšie a pestrejšie.</item>
        <item>Presnejšie a prehľadnejšie vyhľadávanie pomáha rýchlejšie nájsť hudbu.</item>
        <item>Rozšírila sa podpora zvukových formátov.</item>
    </string-array>
    <string-array name="presentation_batch_g_changelog_030_fixes">
        <item>Opravili sa nezrovnalosti v metadátach, aby boli údaje o skladbách všade správne.</item>
        <item>Skratky v upozorneniach opäť spoľahlivo otvárajú prehrávač.</item>
    </string-array>
    <string-array name="presentation_batch_g_changelog_020_added">
        <item>Prehľad zmien v aplikácii s najnovšími funkciami.</item>
        <item>Podpora vložených aj samostatných súborov .LRC.</item>
        <item>Texty skladieb dostupné offline.</item>
        <item>Texty synchronizované s prehrávaním skladby.</item>
        <item>Nová obrazovka s celým frontom.</item>
        <item>Zmena poradia a odstraňovanie skladieb z frontu.</item>
        <item>Gestá miniprehrávača: potiahnutím nadol ho zavriete.</item>
        <item>Ďalšie animácie v štýle Material.</item>
        <item>Nové možnosti prispôsobenia vzhľadu a správania.</item>
        <item>Nové nastavenia na vymazanie vyrovnávacej pamäte.</item>
    </string-array>
    <string-array name="presentation_batch_g_changelog_020_changed">
        <item>Úplne prepracované používateľské rozhranie.</item>
        <item>Úplne prepracovaný prehrávač.</item>
        <item>Lepší výkon knižnice.</item>
        <item>Rýchlejšie spustenie aplikácie.</item>
    </string-array>
    <string-array name="presentation_batch_g_changelog_020_fixed">
        <item>Opravené rôzne chyby v editore metadát.</item>
        <item>Opravené upozornenie na prehrávanie, ktoré sa nedalo zavrieť.</item>
        <item>Opravené viaceré chyby spôsobujúce pády aplikácie.</item>
    </string-array>
    <string-array name="presentation_batch_g_changelog_070_whats_new">
        <item>Prvé verejné vydanie PixelPlayerOSS s otvoreným zdrojovým kódom.</item>
        <item>Obsahuje miestne prehrávanie, zoznamy skladieb, obľúbené, texty, štatistiky počúvania, dynamické motívy Material 3, miniaplikácie, zálohovanie a obnovenie.</item>
        <item>Naďalej podporuje vlastné servery Navidrome, Subsonic a Jellyfin, ako aj voliteľné vyhľadávanie textov cez LRCLIB a fotografií interpretov cez Deezer.</item>
    </string-array>
    <string-array name="presentation_batch_g_changelog_070_improvements">
        <item>Odstránili sa závislosti od služieb Telegram, NetEase, QQ Music, Google Drive, Gemini, Cast, Wear OS, fakturácie Obchodu Play, Firebase, Crashlytics a Služieb Google Play.</item>
        <item>Odstránilo sa odosielanie záznamov počúvania do verejných služieb Last.fm a ListenBrainz. Pri vlastnom serveri Navidrome alebo Subsonic sa záznamy naďalej posielajú len na tento server.</item>
        <item>V prvom otvorenom vydaní sa odstránili priložené preklady aj výber jazyka v aplikácii. Najskôr boli dostupné iba anglické texty.</item>
        <item>Odstránili sa postupy vydávania závislé od miestnych či súkromných podpisových súborov, zástupných podpisových údajov alebo konkrétneho obchodu s aplikáciami.</item>
    </string-array>
    <string-array name="presentation_batch_g_changelog_070_fixes">
        <item>Pribudli metadáta pre F-Droid a Fastlane, poznámky o súkromí a bezpečnosti, dokumentácia závislostí a licencií aj pokyny pre prispievateľov.</item>
        <item>Zostavy vydania zostávajú nepodpísané, ak miestne podpisové kľúče nie sú k dispozícii.</item>
        <item>Pribudla voľba pixelplayer.disableReleaseSigning=true na reprodukovateľné overovanie nepodpísaných zostáv.</item>
        <item>Zdokumentovali sa licencie súborov a závislostí vrátane natívnych a binárnych balíkov Maven a závislostí JitPack.</item>
    </string-array>
    <string-array name="presentation_batch_g_changelog_070_added">
        <item>Cloudové streamovanie cez spätnú slučku teraz vyžaduje token pre každú reláciu.</item>
        <item>Pri obnove zálohy sa vynechávajú kľúče nastavení spravované samostatnými modulmi.</item>
        <item>Sprísnilo sa zapisovanie protokolov vo vydaniach, aby hlavičky požiadaviek HTTP ani surové záznamy Androidu nemohli obísť filter Timber.</item>
        <item>Pribudlo ukladanie inteligentných zoznamov skladieb, vyhľadávanie duplicít a ovládanie rýchlosti prehrávania. Hlásenia o zlyhaní prehrávania či synchronizácie sú zrozumiteľnejšie a zlepšila sa prístupnosť.</item>
    </string-array>
    <string-array name="presentation_batch_g_changelog_v020_whats_new">
        <item>Vzhľad Material 3 Expressive prináša nové animácie pohybu, zvlnené ukazovatele priebehu a zmeny tvarov v celej aplikácii.</item>
        <item>K serverom Jellyfin vo VPN alebo miestnej sieti sa teraz dá pripojiť aj cez obyčajné HTTP.</item>
    </string-array>
    <string-array name="presentation_batch_g_changelog_v020_improvements">
        <item>Menšia aplikácia: úspornejšie pravidlá zmenšovania kódu znižujú veľkosť inštalácie približne o 1,5 MB.</item>
        <item>Rýchlejšie a plynulejšie spustenie: profily Baseline boli vytvorené odznova, aby zodpovedali novému rozhraniu a spôsobu vykonávania kódu.</item>
        <item>Zoznamy, panely a ekvalizér reagujú rýchlejšie vďaka optimalizácii rozhrania Compose.</item>
    </string-array>
    <string-array name="presentation_batch_g_changelog_v020_under_the_hood">
        <item>Spoľahlivejšie prehrávanie z cloudu: zrušené požiadavky Navidrome alebo Jellyfinu sa pri rýchlom preskakovaní skladieb už nehlásia ako chyby siete.</item>
        <item>Pri otočení obrazovky sa už nestrácajú udalosti zálohovania, obnovy ani úvodného nastavenia.</item>
        <item>Odstránil sa nepoužívaný kód, zastarané rozhrania sa nahradili a závislosti sa aktualizovali.</item>
    </string-array>
</resources>
